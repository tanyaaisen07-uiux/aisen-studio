{%- set home = "/" + lang + "/" -%}
<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>{{ t.footer.rights | replace("{year}", "" | year) }}</span>
    <span>{{ t.footer.signature }}</span>
    {%- if site.languages.length > 1 %}
    <span class="lang-switch lang-switch--inline">
      {%- for l in site.languages %}
      {%- if l == lang %}<span class="is-active">{{ l | upper }}</span>{% else %}<a href="{{ page.url | swapLang(l) }}" hreflang="{{ l }}" data-lang-switch="{{ l }}">{{ l | upper }}</a>{% endif %}
      {%- if not loop.last %}<span aria-hidden="true">·</span>{% endif %}
      {%- endfor %}
    </span>
    {%- endif %}
  </div>
</footer>
