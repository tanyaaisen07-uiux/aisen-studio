{%- set home = "/" + lang + "/" -%}
<header class="site-header" data-header>
  <div class="site-header__inner container">
    {#- Место под логотип: сам логотип закреплён в левом верхнем углу и на главной уменьшается при прокрутке -#}
    <span class="site-header__logo-slot" aria-hidden="true"></span>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span data-menu-label data-open="{{ t.nav.menu }}" data-close="{{ t.nav.close }}">{{ t.nav.menu }}</span>
      <svg width="22" height="12" viewBox="0 0 22 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path class="menu-toggle__l1" d="M0 1h22"/><path class="menu-toggle__l2" d="M0 11h22"/></svg>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="site-nav__list">
        <li><a class="site-nav__link" href="{{ home }}work/"{% if page.url.startsWith(home + 'work/') %} aria-current="page"{% endif %}>[ {{ t.nav.work }} ]</a></li>
        <li><a class="site-nav__link" href="{{ home }}#expertise">[ {{ t.nav.expertise }} ]</a></li>
        <li><a class="site-nav__link" href="{{ home }}#studio">[ {{ t.nav.studio }} ]</a></li>
        <li><a class="site-nav__link" href="{{ home }}contact/"{% if page.url.startsWith(home + 'contact/') %} aria-current="page"{% endif %}>[ {{ t.nav.contact }} ]</a></li>
      </ul>
      {%- if site.languages.length > 1 %}
      <div class="lang-switch" role="group" aria-label="Language">
        {%- for l in site.languages %}
        {%- if l == lang %}
        <span class="lang-switch__item is-active" aria-current="true">{{ l | upper }}</span>
        {%- else %}
        <a class="lang-switch__item" href="{{ page.url | swapLang(l) }}" hreflang="{{ l }}" lang="{{ l }}" data-lang-switch="{{ l }}">{{ l | upper }}</a>
        {%- endif %}
        {%- endfor %}
      </div>
      {%- endif %}
    </nav>
  </div>
</header>

<a class="logo" href="{{ home }}" aria-label="{{ t.nav.home }}" data-logo>
  <span class="logo__mark" aria-hidden="true">{% for ch in "AISEN" | list %}<span class="logo__ch"><span style="--i: {{ loop.index0 }}">{{ ch }}</span></span>{% endfor %}</span>
  <span class="logo__sub" aria-hidden="true">{% for ch in "STUDIO" | list %}<span class="logo__ch"><span style="--i: {{ loop.index0 + 5 }}">{{ ch }}</span></span>{% endfor %}</span>
</a>
