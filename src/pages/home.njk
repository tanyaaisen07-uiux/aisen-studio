---
pagination:
  data: homePages
  size: 1
  alias: entry
permalink: "{{ entry.url }}"
layout: layouts/base.njk
pageType: home
eleventyComputed:
  lang: "{{ entry.lang }}"
  homeUrl: "{{ entry.url }}"
  profile: "{{ entry.profile or '' }}"
  title: "{{ ('Aisen Studio · ' + entry.copy.role) if entry.copy.role else i18n[entry.lang].home.title }}"
  description: "{{ entry.copy.intro or i18n[entry.lang].home.description }}"
---
{#- Модульная главная: общие блоки + модульные (роль, интро, компетенции, кейсы, вкладка экспертизы) из profiles.js -#}
{%- set home = "/" + lang + "/" -%}
{%- set cases = entry.cases -%}
{%- set copy = entry.copy -%}

{#- 1. Hero: крупный AISEN STUDIO (логотип в шапке), заголовок, роль, слова-переключатели -#}
<section class="hero container" id="top" data-hero>
  <div class="intro-space" data-intro-space aria-hidden="true"></div>
  <div class="hero__top">
    <div class="hero__head">
      <p class="hero__label mono">{{ t.home.label }}<span class="hero__for" data-for data-prefix="{{ t.home.forPrefix }}" hidden></span></p>
      <h1 class="hero__title">
        {%- for line in t.home.titleLines %}
        <span class="hero__line"><span class="hero__line-inner{% if loop.last %} accent{% endif %}" style="--i: {{ loop.index0 }}">{{ line }}</span></span>
        {%- endfor %}
      </h1>
    </div>
  </div>

  <div class="hero__bottom">
    <div class="hero__main">
      <p class="hero__role">{{ copy.role or t.home.role }}</p>
      <div class="hero__words">
        {%- for w in t.home.words %}
        <a class="pill-word" href="#expertise" data-tab-link="{{ w.tab }}">{{ w.label }}</a>
        {%- endfor %}
      </div>
    </div>
    <div class="hero__side">
      {%- set introText = copy.intro or t.home.intro -%}
      {%- set introParts = introText.split(". ") -%}
      {#- На телефоне показываем только первое предложение, чтобы первый экран был короче -#}
      <p class="hero__intro">{{ introParts[0] }}{% if introParts.length > 1 %}.<span class="hero__intro-more"> {{ introParts.slice(1).join(". ") }}</span>{% endif %}</p>
      <a class="btn btn--dark" href="#work" data-track="cta_click" data-track-label="hero_selected_work">{{ t.home.toWork }}
        <span class="btn__icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 2v12M3 9l5 5 5-5"/></svg></span>
      </a>
    </div>
  </div>
</section>

{#- 2. Плашка компетенций -#}
<section class="container" aria-label="{{ t.home.capsLabel }}">
  <ul class="caps" style="--n: {{ entry.caps.length }}">
    {%- for i in entry.caps %}
    <li class="cap"><span class="cap__num mono">0{{ loop.index }}</span><span class="cap__label">{{ t.home.caps[i] }}</span></li>
    {%- endfor %}
  </ul>
</section>

{#- 3. Selected work: список + крупное превью (desktop), карточки (mobile) -#}
<section class="section container" id="work" aria-labelledby="work-title">
  <header class="section__head">
    <h2 class="section__title" id="work-title">{{ t.home.workTitle }} <span class="section__count mono mono--plain">(0{{ cases.length }})</span></h2>
    <a class="mono link-plain" href="{{ home }}work/">{{ t.links.allWork }}</a>
  </header>

  {#- Список проектов: название * контекст, год. При наведении рядом с годом появляется превью -#}
  <ul class="plist" role="list">
    {%- for item in cases %}
    {%- set href = (home + "work/" + item.slug + "/") if item.hasCase else item.live %}
    <li>
      <a class="plist__row" href="{{ href }}"{% if not item.hasCase %} target="_blank" rel="noopener"{% endif %}
         data-track="{{ 'project_open' if item.hasCase else 'live_demo_open' }}" data-track-label="{{ item.slug }}">
        <span class="plist__title">{{ item.title }}{% if item.tagline %}<span class="plist__sep" aria-hidden="true">*</span><span class="plist__ctx">{{ item.tagline[lang] }}</span>{% endif %}{% if not item.hasCase %} ↗{% endif %}</span>
        <span class="plist__thumb" aria-hidden="true"><img src="{{ item.cover }}" alt="" loading="lazy" decoding="async" style="object-position: {{ item.coverPos }}"></span>
        <span class="plist__year mono mono--plain">{{ item.year }}</span>
      </a>
    </li>
    {%- endfor %}
  </ul>
</section>

{#- 4. Экспертиза: три вкладки -#}
<section class="section section--dark" id="expertise" aria-labelledby="expertise-label">
  <div class="container">
    <h2 class="section__title section__title--dark" id="expertise-label">{{ t.expertise.label }}</h2>
    <div class="expertise" data-tabs>
      <div class="expertise__tabs" role="tablist" aria-labelledby="expertise-label">
        {%- for key in entry.tabs %}{% for tab in t.expertise.tabs %}{% if tab.key == key %}
        <button class="expertise__tab" type="button" role="tab" id="tab-{{ tab.key }}" aria-controls="panel-{{ tab.key }}"
                aria-selected="{{ 'true' if key == entry.tabs[0] else 'false' }}" tabindex="{{ '0' if key == entry.tabs[0] else '-1' }}" data-tab="{{ tab.key }}">
          <span class="expertise__num mono mono--plain">0{{ entry.tabs.indexOf(key) + 1 }}</span>
          <span class="expertise__title">{{ tab.title }}</span>
        </button>
        {%- endif %}{% endfor %}{% endfor %}
      </div>
      {%- for key in entry.tabs %}{% for tab in t.expertise.tabs %}{% if tab.key == key %}
      {%- set first = (key == entry.tabs[0]) %}
      <div class="expertise__panel" role="tabpanel" id="panel-{{ tab.key }}" aria-labelledby="tab-{{ tab.key }}" tabindex="0"{% if not first %} hidden{% endif %}>
        <p class="expertise__lead">{{ tab.lead }}</p>
        <ul class="expertise__items">
          {%- for it in tab.items %}<li>{{ it }}</li>{% endfor %}
        </ul>
        <p class="mono on-dark-soft">{{ t.expertise.related }}</p>
        <div class="expertise__projects">
          {%- for slug in tab.projects %}
          {%- for item in cases %}{% if item.slug == slug %}
          {%- set href = (home + "work/" + item.slug + "/") if item.hasCase else item.live %}
          <a class="chip chip--dark" href="{{ href }}"{% if not item.hasCase %} target="_blank" rel="noopener"{% endif %}>{{ item.title }} ↗</a>
          {%- endif %}{% endfor %}
          {%- endfor %}
        </div>
      </div>
      {%- endif %}{% endfor %}{% endfor %}
    </div>
  </div>
</section>

{#- 5. Студия: портрет, текст, сноска, шаги -#}
<section class="section container" id="studio" aria-labelledby="studio-label">
  <div class="studio">
    {#- Фото основателя: только здесь, не на первом экране -#}
    <figure class="studio__portrait reveal">
      <div class="studio__photo"><img src="/assets/img/about/tania-portrait.webp" alt="{{ t.studio.portraitAlt }}" loading="lazy" decoding="async" width="900" height="1117"></div>
      <figcaption class="mono mono--plain soft">{{ t.studio.caption }}</figcaption>
    </figure>
    <div class="studio__text">
      <p class="mono soft" id="studio-label">{{ t.studio.label }}</p>
      <p class="studio__statement">{{ t.studio.statement }}<sup class="mono mono--plain accent">1</sup></p>
      <p class="studio__note mono mono--plain soft"><span class="accent">1</span> {{ t.studio.note }}</p>
      <div class="xp" aria-label="{{ t.studio.xpLabel }}">
        {%- for x in t.studio.xp %}
        <p class="xp__row"><span class="mono mono--plain soft">{{ x.years }}</span><span><strong>{{ x.place }}</strong> · {{ x.role }}</span></p>
        {%- endfor %}
      </div>
      <a class="mono link-plain" href="{{ home }}contact/">{{ t.studio.workWithMe }}</a>
    </div>
  </div>
  <ol class="steps">
    {%- for step in t.studio.steps %}
    <li class="step reveal">
      <span class="mono mono--plain accent">0{{ loop.index }}</span>
      <h3 class="step__title">{{ step.title }}</h3>
      <p class="soft">{{ step.text }}</p>
    </li>
    {%- endfor %}
  </ol>

  {#- Инструменты -#}
  <div class="tools" id="tools">
    <p class="mono soft tools__label">{{ t.tools.label }}</p>
    {%- for row in t.tools.rows %}
    <div class="tools__row reveal">
      <span class="mono mono--plain accent">0{{ loop.index }}</span>
      <span class="tools__title">{{ row.title }}</span>
      <span class="tools__chips">{% for it in row.items %}<span class="tool">{{ it }}</span>{% endfor %}</span>
    </div>
    {%- endfor %}
  </div>
</section>

{#- 6. Финальный экран: Contact -#}
<section class="contact-band" aria-labelledby="contact-title">
  <div class="container contact-band__grid">
    <div class="contact-band__main">
      <p class="mono">{{ t.contact.label }}</p>
      <h2 class="contact-band__title" id="contact-title">{% for l in t.contact.titleLines %}<span class="contact-band__line">{{ l }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h2>
      <a class="btn btn--light btn--lg" href="{{ home }}contact/" data-track="cta_click" data-track-label="home_start_project">{{ t.contact.start }}
        <span class="btn__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 8h12M9 3l5 5-5 5"/></svg></span>
      </a>
    </div>
    <div class="contact-band__side">
      <div class="person">
        <span><strong>{{ site.author if lang != 'ru' else 'Таня Айсен' }}</strong><span class="mono mono--plain">{{ t.contact.founder }}</span></span>
      </div>
      {%- if site.showClock %}
      <p class="clock" data-clock data-tz="{{ site.timezone }}" hidden>
        <span class="mono">{{ t.contact.localTime }}</span>
        <time class="clock__time" data-clock-time></time>
        <span class="mono mono--plain" data-clock-zone></span>
      </p>
      {%- endif %}
      <ul class="contact-band__links">
        {%- for c in site.contacts %}
        <li><a href="{{ c.href }}"{% if c.external %} target="_blank" rel="noopener"{% endif %} data-track="cta_click" data-track-label="home_{{ c.label | slugify }}">{{ c.label }}{% if c.external %} ↗{% endif %}</a></li>
        {%- endfor %}
      </ul>
      <p class="status"><span class="status__dot" aria-hidden="true"></span>{{ t.contact.statusStudio if entry.studio else t.contact.status }}</p>
    </div>
  </div>
</section>
