---
pagination:
  data: casePages
  size: 1
  alias: entry
permalink: "/{{ entry.lang }}/work/{{ entry.item.slug }}/"
layout: layouts/base.njk
pageType: case
eleventyComputed:
  lang: "{{ entry.lang }}"
  title: "{{ entry.item.title }} · Aisen Studio"
  description: "{{ entry.item.summary[entry.lang] }}"
---
{%- set item = entry.item -%}
{%- set c = entry.content -%}
{%- set home = "/" + lang + "/" -%}
{%- set p = t.case.playground -%}
<article class="case">
  <header class="container case__head">
    <a class="mono link-plain soft" href="{{ home }}work/">{{ t.case.back }}</a>
    <p class="mono soft case__label">{{ c.label }}</p>
    <h1 class="case__title">{{ item.title }}<span class="drop" aria-hidden="true"></span></h1>
    <p class="case__lead">{{ c.lead }}</p>
    <dl class="case__tldr">
      <div><dt class="mono">{{ t.case.platform }}</dt><dd>{{ c.platform }}</dd></div>
      <div><dt class="mono">{{ t.case.type }}</dt><dd>{{ t.types[item.type] }}</dd></div>
      <div><dt class="mono">{{ t.case.year }}</dt><dd>{{ item.year }}</dd></div>
      {%- if item.live %}
      <div><dt class="mono">{{ t.case.demo }}</dt><dd><a href="{{ item.live }}" target="_blank" rel="noopener" data-track="live_demo_open" data-track-label="{{ item.slug }}">{{ t.links.demo }}</a></dd></div>
      {%- endif %}
    </dl>
    {%- if item.nameChanged %}<p class="mono mono--plain soft case__note">{{ t.nameChanged }}</p>{% endif %}
  </header>

  <div class="container">
    <div class="case__cover" style="view-transition-name: cover-{{ item.slug }}">
      <img src="{{ item.cover }}" alt="{{ item.title }}" style="object-position: {{ item.coverPos }}">
    </div>
  </div>

  {%- if item.slug == "cohorta" %}
  {#- Product UI playground: настоящие переключатели роли, темы и состояния -#}
  <section class="container case__section" aria-labelledby="pg-label">
    <div class="case__grid">
      <p class="mono accent case__side" id="pg-label">01 · {{ p.label }}</p>
      <p class="case__statement">{{ p.lead }}</p>
    </div>
    <div class="playground" data-playground data-lang="{{ lang }}">
      <div class="playground__controls">
        <div class="seg-group" role="group" aria-label="{{ p.role }}">
          <span class="mono on-dark-soft">{{ p.role }}</span>
          <div class="seg">
            {%- for key, label in p.roles %}<button class="seg__btn" type="button" data-pg="role" data-value="{{ key }}" aria-pressed="{{ 'true' if key == 'instructor' else 'false' }}">{{ label }}</button>{% endfor %}
          </div>
        </div>
        <div class="seg-group" role="group" aria-label="{{ p.theme }}">
          <span class="mono on-dark-soft">{{ p.theme }}</span>
          <div class="seg">
            {%- for key, label in p.themes %}<button class="seg__btn" type="button" data-pg="theme" data-value="{{ key }}" aria-pressed="{{ 'true' if key == 'light' else 'false' }}">{{ label }}</button>{% endfor %}
          </div>
        </div>
        <div class="seg-group" role="group" aria-label="{{ p.state }}">
          <span class="mono on-dark-soft">{{ p.state }}</span>
          <div class="seg">
            {%- for key, label in p.states %}<button class="seg__btn" type="button" data-pg="view" data-value="{{ key }}" aria-pressed="{{ 'true' if key == 'default' else 'false' }}">{{ label }}</button>{% endfor %}
          </div>
        </div>
      </div>
      <div class="mini-app" data-theme="light" data-mini-app aria-live="polite">
        <aside class="mini-app__side"><span class="mini-app__logo">cohorta</span><ul class="mini-app__menu" data-mini-menu></ul></aside>
        <div class="mini-app__main">
          <div class="mini-app__head"><h3 data-mini-title></h3><span class="mini-app__meta" data-mini-meta></span></div>
          <div data-mini-body></div>
        </div>
      </div>
      <p class="playground__caption mono mono--plain">{{ p.caption }}</p>
    </div>
  </section>
  {%- endif %}

  {%- if item.beforeAfter %}
  {#- До и после: слайдеры сравнения (кейс с ретушью) -#}
  {%- set ba = t.case.beforeAfter -%}
  <section class="container case__section case__section--last" aria-labelledby="ba-label">
    <div class="case__grid">
      <p class="mono accent case__side" id="ba-label">01 · {{ ba.label }}</p>
      <p class="case__statement">{{ ba.lead }}</p>
    </div>
    <div class="ba-list">
      {%- for pair in item.beforeAfter %}
      <article class="ba-item reveal">
        <div class="ba" style="--pos: 50%; --ar: {{ pair.ratio }}" data-ba tabindex="0" role="slider"
             aria-label="{{ ba.aria }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
          <img class="ba__img" src="{{ pair.after }}" alt="{{ ba.after }}: {{ pair.title[lang] }}" loading="lazy" decoding="async">
          <img class="ba__img ba__img--before" src="{{ pair.before }}" alt="{{ ba.before }}: {{ pair.title[lang] }}" loading="lazy" decoding="async">
          <span class="ba__tag ba__tag--before mono mono--plain">{{ ba.before }}</span>
          <span class="ba__tag ba__tag--after mono mono--plain">{{ ba.after }}</span>
          <span class="ba__handle" aria-hidden="true"><span class="ba__knob">‹ ›</span></span>
        </div>
        <div class="ba-item__text">
          <span class="mono mono--plain accent">0{{ loop.index }}</span>
          <h3 class="decision__title">{{ pair.title[lang] }}</h3>
          <p class="soft">{{ pair.text[lang] }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if c.decisions %}
  <section class="container case__section" aria-labelledby="dec-label">
    <div class="case__grid">
      <p class="mono accent case__side" id="dec-label">02 · {{ t.case.decisionsLabel }}</p>
      <p class="case__statement">{{ t.case.decisionsLead }}</p>
    </div>
    <div class="decisions">
      {%- for d in c.decisions %}
      <article class="decision reveal">
        <span class="mono mono--plain accent">0{{ loop.index }}</span>
        <h3 class="decision__title">{{ d.title }}</h3>
        <p class="soft">{{ d.text }}</p>
      </article>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if item.live %}
  <section class="container case__section case__section--last">
    <div class="case__grid">
      <span class="case__side"></span>
      <a class="btn btn--dark btn--lg" href="{{ item.live }}" target="_blank" rel="noopener" data-track="live_demo_open" data-track-label="{{ item.slug }}_cta">{{ t.case.demoCta }}
        <span class="btn__icon" aria-hidden="true">↗</span></a>
    </div>
  </section>
  {%- endif %}

  {%- set n = entry.next %}
  <a class="case-next" href="{{ (home + 'work/' + n.slug + '/') if n.hasCase else (home + 'work/') }}" data-track="project_open" data-track-label="next_{{ n.slug }}">
    <span class="container case-next__inner">
      <span class="case-next__text">
        <span class="mono on-dark-soft">{{ t.case.next }}</span>
        <span class="case-next__title">{{ n.title }}</span>
      </span>
      <span class="case-next__visual">
        <img src="{{ n.cover }}" alt="" loading="lazy" style="object-position: {{ n.coverPos }}">
        <svg width="48" height="48" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"/></svg>
      </span>
    </span>
  </a>
</article>
