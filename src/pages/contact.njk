---
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "/{{ lang }}/contact/"
layout: layouts/base.njk
pageType: contact
eleventyComputed:
  title: "{{ i18n[lang].contact.pageTitle }}"
  description: "{{ i18n[lang].contact.pageDescription }}"
---
<section class="page-head container">
  <p class="mono soft">{{ t.contact.label }}</p>
  <h1 class="page-head__title">{{ t.contact.heading }}<span class="drop" aria-hidden="true"></span></h1>
  <p class="page-head__lead soft">{{ t.contact.text }}</p>
</section>

<section class="container contact-page">
  {%- if site.formAccessKey %}
  <form class="form" action="https://api.web3forms.com/submit" method="POST" novalidate data-form
        data-msg-required="{{ t.contact.form.required }}" data-msg-email="{{ t.contact.form.emailInvalid }}"
        data-msg-success="{{ t.contact.form.success }}" data-msg-error="{{ t.contact.form.error }}"
        data-msg-sending="{{ t.contact.form.sending }}">
    <input type="hidden" name="access_key" value="{{ site.formAccessKey }}">
    <input type="hidden" name="subject" value="Aisen Studio · new message ({{ lang }})">
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <div class="field">
      <label class="field__label" for="f-name">{{ t.contact.form.name }}</label>
      <input class="field__input" id="f-name" name="name" type="text" autocomplete="name" required>
      <p class="field__error" id="f-name-err" aria-live="polite"></p>
    </div>
    <div class="field">
      <label class="field__label" for="f-email">{{ t.contact.form.email }}</label>
      <input class="field__input" id="f-email" name="email" type="email" autocomplete="email" required>
      <p class="field__error" id="f-email-err" aria-live="polite"></p>
    </div>
    <div class="field">
      <label class="field__label" for="f-msg">{{ t.contact.form.message }}</label>
      <textarea class="field__input" id="f-msg" name="message" rows="5" required></textarea>
      <p class="field__error" id="f-msg-err" aria-live="polite"></p>
    </div>
    <button class="btn btn--dark btn--lg" type="submit">{{ t.contact.form.send }}</button>
    <p class="form__status" role="status" data-form-status></p>
  </form>
  {%- endif %}

  <div class="contact-page__side">
    <div class="person">
      <img src="/assets/img/about/tania-avatar.webp" alt="" width="64" height="64">
      <span><strong>{{ site.author if lang != 'ru' else 'Таня Айсен' }}</strong><span class="mono mono--plain soft">{{ t.contact.founder }}</span></span>
    </div>
    <p class="mono soft">{{ t.contact.elsewhere }}</p>
    <ul class="contact-page__list">
      {%- for c in site.contacts %}
      <li><a href="{{ c.href }}"{% if c.external %} target="_blank" rel="noopener"{% endif %} data-track="cta_click" data-track-label="contact_{{ c.label | slugify }}">{{ c.label }}{% if c.external %} <span aria-hidden="true">↗</span>{% endif %}</a></li>
      {%- endfor %}
    </ul>
    {%- if site.cvFile[lang] %}
    <a class="btn btn--outline" href="{{ site.cvFile[lang] }}" download data-track="cv_download">{{ t.contact.cv }}</a>
    {%- endif %}
    <p class="status"><span class="status__dot" aria-hidden="true"></span>{{ t.contact.status }}</p>
  </div>
</section>
