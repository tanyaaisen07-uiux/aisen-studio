---
pagination:
  data: site.languages
  size: 1
  alias: lang
permalink: "/{{ lang }}/work/"
layout: layouts/base.njk
pageType: work
eleventyComputed:
  title: "{{ i18n[lang].work.title }}"
  description: "{{ i18n[lang].work.description }}"
---
<section class="page-head container">
  <p class="mono soft">{{ t.work.eyebrow }}</p>
  <div class="page-head__row">
    <h1 class="page-head__title">{{ t.work.heading }}<span class="drop" aria-hidden="true"></span>
      <span class="page-head__count mono mono--plain">(<span data-count>0{{ cases.length }}</span>)</span></h1>
    <p class="page-head__intro mono mono--plain soft">{{ t.work.intro }}</p>
  </div>

  <div class="filters" role="group" aria-label="{{ t.work.filterLabel }}" data-filters>
    {%- for key in ["all", "brand", "web", "product", "visual"] %}
    <button class="filter" type="button" data-filter="{{ key }}" aria-pressed="{{ 'true' if key == 'all' else 'false' }}">
      {{ t.categories[key] }} <span class="filter__n mono mono--plain" data-filter-count="{{ key }}"></span>
    </button>
    {%- endfor %}
  </div>
</section>

<section class="container" aria-label="{{ t.work.heading }}">
  <div class="work-grid" data-grid>
    {%- for item in cases %}
    {% include "partials/card.njk" %}
    {%- endfor %}
  </div>
  <p class="work-empty soft" data-empty hidden>{{ t.work.empty }}</p>
</section>
